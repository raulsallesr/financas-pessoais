{
  "expo": {
    "name": "FocusLens BR",
    "slug": "focuslens-br",
    "version": "0.4.1",
    "orientation": "default",
    "scheme": "focuslens",
    "icon": "./assets/focuslens-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F7F5",
    "primaryColor": "#0F766E",
    "ios": {
      "bundleIdentifier": "com.raulsallesr.focuslens",
      "buildNumber": "5",
      "supportsTablet": true
    },
    "android": {
      "package": "com.raulsallesr.focuslens",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#E7F1EE",
        "foregroundImage": "./assets/focuslens-foreground.png",
        "monochromeImage": "./assets/focuslens-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/focuslens-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/focuslens-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7F5"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0f97a2a-f26f-4b53-ac1b-fafe4ef27b4b"
      }
    },
    "owner": "raulsallesr"
  }
}
