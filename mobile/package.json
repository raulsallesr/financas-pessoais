{
  "name": "focuslens-mobile",
  "version": "0.5.3",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "expo": "~57.0.18",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "fflate": "0.8.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "typecheck:components": "tsc -p tsconfig.components.json --noEmit",
    "test": "npm run test:domain && npm run test:components && npm run test:e2e:contracts",
    "test:domain": "tsc -p tsconfig.domain.json && node --test --test-isolation=none tests/domain/*.test.cjs",
    "test:components": "npm run typecheck:components && jest --config jest.config.cjs --runInBand",
    "test:e2e:contracts": "node --test --test-isolation=none tests/e2e/*.test.cjs",
    "e2e:maestro": "maestro test e2e/maestro",
    "e2e:maestro:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-maestro-windows.ps1",
    "e2e:maestro:check:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-maestro-windows.ps1 -CheckSyntaxOnly",
    "export:android": "expo export --platform android --output-dir dist-android"
  },
  "private": true
}
